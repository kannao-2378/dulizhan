{{ 'gomad-product-showcase.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-drawer.css' | asset_url | stylesheet_tag }}

{% assign featured_product = section.settings.product %}
{% if featured_product == blank %}
  {% assign featured_product = all_products['akabang-bangtuan'] %}
{% endif %}

<section class="gp-showcase" data-gp-section="{{ section.id }}">
  <div class="gp-showcase__inner">
    <div class="gp-gallery" data-gp-gallery>
      <div class="gp-gallery__stage">
        {% if featured_product != blank and featured_product.media.size > 0 %}
          {% for media in featured_product.media %}
            {% if media.media_type == 'image' %}
              <figure class="gp-gallery__slide{% if forloop.first %} is-active{% endif %}" data-gp-slide>
                {{ media.preview_image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '640, 900, 1200, 1600, 1800', sizes: '(min-width: 990px) 56vw, 100vw', alt: media.alt | default: featured_product.title }}
              </figure>
            {% endif %}
          {% endfor %}
        {% else %}
          <figure class="gp-gallery__slide is-active gp-gallery__placeholder">{{ 'product-1' | placeholder_svg_tag }}</figure>
        {% endif %}
        {% if section.settings.savings_badge != blank %}<span class="gp-gallery__badge">{{ section.settings.savings_badge }}</span>{% endif %}
        <button class="gp-gallery__nav gp-gallery__nav--prev" type="button" data-gp-prev aria-label="Previous image">‹</button>
        <button class="gp-gallery__nav gp-gallery__nav--next" type="button" data-gp-next aria-label="Next image">›</button>
        <div class="gp-spin" data-gp-spin hidden>
          {% for i in (1..17) %}
            {% capture frame_name %}gomad-360-{% if i < 10 %}0{% endif %}{{ i }}.webp{% endcapture %}
            <img src="{{ frame_name | asset_url }}" alt="GoMad 360 view frame {{ i }}" draggable="false"{% unless forloop.first %} hidden{% endunless %} data-gp-frame>
          {% endfor %}
          <p>Drag left or right to rotate</p><button type="button" data-gp-spin-close aria-label="Close 360 view">×</button>
        </div>
      </div>
      <div class="gp-gallery__toolbar">
        <span class="gp-gallery__counter"><span data-gp-current>1</span> / <span data-gp-total>{{ featured_product.media.size | default: 1 }}</span> Images</span>
        <button class="gp-gallery__view" type="button" data-gp-360>⬡ 360 View</button>
      </div>
      <div class="gp-trust">
        <div><span class="gp-trust-icon">▤</span><p><strong>{{ section.settings.trust_1_title }}</strong><small>{{ section.settings.trust_1_text }}</small></p></div>
        <div><span class="gp-trust-icon gp-ul">UL</span><p><strong>{{ section.settings.trust_2_title }}</strong><small>{{ section.settings.trust_2_text }}</small></p></div>
        <div><span class="gp-trust-icon">♢</span><p><strong>{{ section.settings.trust_3_title }}</strong><small>{{ section.settings.trust_3_text }}</small></p></div>
      </div>
    </div>

    <div class="gp-info">
      <p class="gp-info__eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ featured_product.title | default: 'AKAbang bangtuan' }}</h1>
      <div class="gp-rating" aria-label="Rated {{ section.settings.rating }} out of 5">
        <span>★★★★★</span><a href="#">{{ section.settings.review_count }} Reviews</a>
      </div>
      <div class="gp-price">
        <strong>{{ featured_product.price | default: 199900 | money }}</strong>
        {% if featured_product.compare_at_price > featured_product.price %}<s>{{ featured_product.compare_at_price | money }}</s>{% endif %}
        {% if section.settings.savings_badge != blank %}<span>{{ section.settings.savings_badge }}</span>{% endif %}
      </div>
      <p class="gp-finance">{{ section.settings.finance_text }}</p>

      {% if featured_product != blank %}
        {% form 'product', featured_product, class: 'gp-form' %}
          {% if featured_product.has_only_default_variant %}
            <fieldset class="gp-option">
              <legend><strong>Package:</strong> <span>size: 5'0&quot;-6'3&quot;</span></legend>
              <div class="gp-option__values">
                <label><input type="radio" name="demo-package" value="GoMad + Young Passenger Kit" data-gp-image="0" checked><span>GoMad + Young Passenger Kit</span></label>
                <label><input type="radio" name="demo-package" value="GoMad + Passenger Kit" data-gp-image="3"><span>GoMad + Passenger Kit</span></label>
                <label><input type="radio" name="demo-package" value="GoMad Only" data-gp-image="1"><span>GoMad Only</span></label>
              </div>
            </fieldset>
            <fieldset class="gp-option gp-option--color">
              <legend><strong>Color:</strong> <span data-gp-color-label>Dark Amber</span></legend>
              <div class="gp-colors">
                <label><input type="radio" name="demo-color" value="Dark Amber" data-gp-image="1" checked><span style="--swatch:#bb4938"></span></label>
                <label><input type="radio" name="demo-color" value="Obsidian" data-gp-image="2"><span style="--swatch:linear-gradient(135deg,#bb3e32,#e6b72e,#2b7987,#161616)"></span></label>
                <label><input type="radio" name="demo-color" value="Sage" data-gp-image="4"><span style="--swatch:#77784f"></span></label>
              </div>
            </fieldset>
          {% else %}
            {% for option in featured_product.options_with_values %}
              <fieldset class="gp-option">
                <legend><strong>{{ option.name }}:</strong> <span data-gp-option-label>{{ option.selected_value }}</span></legend>
                <div class="gp-option__values">
                  {% for value in option.values %}
                    <label>
                      <input type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}>
                      <span>{{ value }}</span>
                    </label>
                  {% endfor %}
                </div>
              </fieldset>
            {% endfor %}
          {% endif %}
          <input type="hidden" name="id" value="{{ featured_product.selected_or_first_available_variant.id }}">

          <div class="gp-specs">
            <div><img src="{{ 'gomad-icon-payload.svg' | asset_url }}" alt=""><em>Max Payload</em><strong>{{ section.settings.spec_payload }}</strong></div>
            <div><img src="{{ 'gomad-icon-motor.svg' | asset_url }}" alt=""><em>Motor</em><strong>{{ section.settings.spec_motor }}</strong></div>
            <div><img src="{{ 'gomad-icon-range.svg' | asset_url }}" alt=""><em>Max Range</em><strong>{{ section.settings.spec_range }}</strong></div>
            <div><img src="{{ 'gomad-icon-battery.svg' | asset_url }}" alt=""><em>Battery</em><strong>{{ section.settings.spec_battery }}</strong></div>
            <div><img src="{{ 'gomad-icon-speed.svg' | asset_url }}" alt=""><em>Top Speed</em><strong>{{ section.settings.spec_speed }}</strong></div>
            <div><img src="{{ 'gomad-icon-sensor.svg' | asset_url }}" alt=""><em>SensorSwap™</em><strong>{{ section.settings.spec_sensor }}</strong></div>
            <div><img src="{{ 'gomad-icon-modes.svg' | asset_url }}" alt=""><em>Pedal Assist Mode</em><strong>{{ section.settings.spec_modes }} ⓘ</strong></div>
          </div>
          <button class="gp-more" type="button">Learn about More Features</button>
          <div class="gp-benefits"><img src="{{ 'gomad-benefits.svg' | asset_url }}" alt="14-Day Trial, Free Shipping, 2-Year Warranty"><b>＋</b></div>
          <button class="gp-buy" type="submit" name="add"{% unless featured_product.available %} disabled{% endunless %}>{% if featured_product.available %}Buy Now{% else %}Unavailable{% endif %}</button>
          <button class="gp-test" type="button" data-gp-test>Test Ride</button>
          <p class="gp-action-message" data-gp-message role="status" hidden></p>
          <div class="gp-enhance">
            <h2>Enhance Your Ride</h2><h3>Add 3, save 30% <small>ⓘ</small></h3>
            <div class="gp-accessories">
              <label><input type="checkbox" data-gp-accessory><img src="{{ 'gomad-accessory-battery.png' | asset_url }}" alt=""><span><strong>Velotric Extra Battery Pack</strong><b>$549.99</b><select><option>GoMad / Standard / Black</option></select></span><i>›</i></label>
              <label><input type="checkbox" data-gp-accessory><img src="{{ 'gomad-accessory-cover.png' | asset_url }}" alt=""><span><strong>Velotric Battery Cover Plate</strong><b>$45.99</b><select><option>GoMad / Sage</option><option>GoMad / Obsidian</option><option>GoMad / Dark Amber</option></select></span><i>›</i></label>
              <label><input type="checkbox" data-gp-accessory><img src="{{ 'gomad-accessory-rack.png' | asset_url }}" alt=""><span><strong>Velotric Front Rack</strong><b>$79.99</b></span><i>›</i></label>
              <footer><strong><span data-gp-selected>0</span> Selected</strong><button type="button">Show More</button></footer>
            </div>
            <div class="gp-accordions"><details><summary>▧ <b>What’s in the Box</b></summary><p>Bike, charger, battery, pedals, keys and assembly tools.</p></details><details><summary>▣ <b>Verify Discount</b></summary><p>Discount verification will be connected before launch.</p></details></div>
            <div class="gp-quiz"><h3>Which Ebike is Right for Me?</h3><p>Take our 30-sec quiz for a personalized recommendation or compare top models.</p><div><button type="button">Take Quiz</button><button type="button">Compare Models</button></div></div>
          </div>
        {% endform %}
      {% else %}
        <div class="gp-empty">Choose a product in the theme editor to display it here.</div>
      {% endif %}
    </div>
  </div>
</section>

<script>
(() => {
  const root = document.querySelector('[data-gp-section="{{ section.id }}"]');
  if (!root || root.dataset.ready) return;
  root.dataset.ready = 'true';
  const slides = [...root.querySelectorAll('[data-gp-slide]')];
  const current = root.querySelector('[data-gp-current]');
  const total = root.querySelector('[data-gp-total]');
  let index = 0;
  if (total) total.textContent = Math.max(slides.length, 1);
  const show = (next) => {
    if (!slides.length) return;
    index = (next + slides.length) % slides.length;
    slides.forEach((slide, i) => slide.classList.toggle('is-active', i === index));
    if (current) current.textContent = index + 1;
  };
  root.querySelector('[data-gp-prev]')?.addEventListener('click', () => show(index - 1));
  root.querySelector('[data-gp-next]')?.addEventListener('click', () => show(index + 1));
  const spin = root.querySelector('[data-gp-spin]');
  const frames = [...root.querySelectorAll('[data-gp-frame]')];
  let frame = 0, dragging = false, startX = 0, startFrame = 0;
  const showFrame = n => { frame = (n + frames.length) % frames.length; frames.forEach((img,i) => img.hidden = i !== frame); };
  root.querySelector('[data-gp-360]')?.addEventListener('click', () => { if (spin) spin.hidden = false; });
  root.querySelector('[data-gp-spin-close]')?.addEventListener('click', () => { spin.hidden = true; });
  spin?.addEventListener('pointerdown', e => { if (e.target.closest('button')) return; dragging=true; startX=e.clientX; startFrame=frame; spin.setPointerCapture(e.pointerId); });
  spin?.addEventListener('pointermove', e => { if (dragging) showFrame(startFrame + Math.round((startX-e.clientX)/14)); });
  spin?.addEventListener('pointerup', () => dragging=false);
  spin?.addEventListener('pointercancel', () => dragging=false);
  root.querySelectorAll('.gp-option input').forEach(input => input.addEventListener('change', () => {
    const label = input.closest('fieldset')?.querySelector('[data-gp-option-label]');
    if (label) label.textContent = input.value;
    if (input.dataset.gpImage) show(Number(input.dataset.gpImage));
  }));
  root.querySelectorAll('.gp-colors input').forEach(input => input.addEventListener('change', () => {
    const label = root.querySelector('[data-gp-color-label]');
    if (label) label.textContent = input.value;
  }));
  const moreButton = root.querySelector('.gp-more');
  const specs = root.querySelector('.gp-specs');
  moreButton?.addEventListener('click', () => {
    const collapsed = specs.classList.toggle('is-collapsed');
    moreButton.textContent = collapsed ? 'Learn about More Features' : 'Show Fewer Features';
  });
  root.querySelector('[data-gp-test]')?.addEventListener('click', () => {
    const message = root.querySelector('[data-gp-message]');
    if (!message) return;
    message.hidden = false;
    message.textContent = 'Test Ride is ready for your final booking link.';
  });
  const count = root.querySelector('[data-gp-selected]');
  root.querySelectorAll('[data-gp-accessory]').forEach(box => box.addEventListener('change', () => { if(count) count.textContent=root.querySelectorAll('[data-gp-accessory]:checked').length; }));
})();
</script>

{% schema %}
{
  "name": "GoMad product showcase",
  "settings": [
    {"type":"product","id":"product","label":"Product"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Compact Cargo Ebike"},
    {"type":"text","id":"rating","label":"Rating","default":"4.9"},
    {"type":"text","id":"review_count","label":"Review count","default":"29"},
    {"type":"text","id":"savings_badge","label":"Savings badge","default":"Save $284.99"},
    {"type":"text","id":"finance_text","label":"Finance text","default":"Starting at $125/mo or 0% APR with affirm."},
    {"type":"header","content":"Specifications"},
    {"type":"text","id":"spec_payload","label":"Max payload","default":"500 Lbs/176 Lbs Rear Rack (MIK HD)"},
    {"type":"text","id":"spec_motor","label":"Motor","default":"750W (1300W Peak) /85Nm"},
    {"type":"text","id":"spec_range","label":"Max range","default":"75 Miles"},
    {"type":"text","id":"spec_battery","label":"Battery","default":"801.6 Wh/48V"},
    {"type":"text","id":"spec_speed","label":"Top speed","default":"28 MPH"},
    {"type":"text","id":"spec_sensor","label":"Sensor","default":"Torque/Cadence"},
    {"type":"text","id":"spec_modes","label":"Pedal assist modes","default":"5 Modes"},
    {"type":"header","content":"Trust row"},
    {"type":"text","id":"trust_1_title","label":"Trust 1 title","default":"1,600+ Dealer Shops"},
    {"type":"text","id":"trust_1_text","label":"Trust 1 text","default":"Reliable and Trusted"},
    {"type":"text","id":"trust_2_title","label":"Trust 2 title","default":"Safety Certified"},
    {"type":"text","id":"trust_2_text","label":"Trust 2 text","default":"UL2271/UL2849 Certification"},
    {"type":"text","id":"trust_3_title","label":"Trust 3 title","default":"Waterproof"},
    {"type":"text","id":"trust_3_text","label":"Trust 3 text","default":"IPX7 Battery, IPX6 Frame"}
  ],
  "presets": [{"name":"GoMad product showcase"}]
}
{% endschema %}
