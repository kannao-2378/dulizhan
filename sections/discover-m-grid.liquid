{{ 'discover-m-grid.css' | asset_url | stylesheet_tag }}
{% capture dm_image_1 %}{% if section.settings.image_1 != blank %}{{ section.settings.image_1 | image_url: width: 1800 }}{% else %}{{ 'discover-m-grid-feature-1.jpg' | asset_url }}{% endif %}{% endcapture %}
{% capture dm_image_2 %}{% if section.settings.image_2 != blank %}{{ section.settings.image_2 | image_url: width: 1800 }}{% else %}https://www.velotricbike.com/cdn/shop/files/long_range_mid_drive_electric_bike.webp?v=7197533249922931453{% endif %}{% endcapture %}
{% capture dm_image_3 %}{% if section.settings.image_3 != blank %}{{ section.settings.image_3 | image_url: width: 1800 }}{% else %}https://www.velotricbike.com/cdn/shop/files/powerful_mid_drive_ebike_for_climbing_hill.webp?v=17164462524060649343{% endif %}{% endcapture %}
{% capture dm_image_4 %}{% if section.settings.image_4 != blank %}{{ section.settings.image_4 | image_url: width: 1200 }}{% else %}https://www.velotricbike.com/cdn/shop/files/comfort_mid_drive_ebike_for_seniors.webp?v=324194211173503404{% endif %}{% endcapture %}
{% capture dm_image_5 %}{% if section.settings.image_5 != blank %}{{ section.settings.image_5 | image_url: width: 1200 }}{% else %}https://www.velotricbike.com/cdn/shop/files/velotric_discover_m_hydraulic_disc_brake.webp?v=10726079988003261100{% endif %}{% endcapture %}
{% capture dm_image_6 %}{% if section.settings.image_6 != blank %}{{ section.settings.image_6 | image_url: width: 1200 }}{% else %}https://www.velotricbike.com/cdn/shop/files/velotric_discover_m_front_suspension_fork.webp?v=6463564928672444581{% endif %}{% endcapture %}
{% capture dm_image_7 %}{% if section.settings.image_7 != blank %}{{ section.settings.image_7 | image_url: width: 1200 }}{% else %}https://www.velotricbike.com/cdn/shop/files/velotric_discover_m_suspension_seatpost_2.webp?v=1900871556454546865{% endif %}{% endcapture %}
{% capture dm_image_8 %}{% if section.settings.image_8 != blank %}{{ section.settings.image_8 | image_url: width: 800 }}{% else %}https://www.velotricbike.com/cdn/shop/files/velotric_discover_m_smart_locating_feature.webp?v=12993170215933566388{% endif %}{% endcapture %}
{% capture dm_image_9 %}{% if section.settings.image_9 != blank %}{{ section.settings.image_9 | image_url: width: 800 }}{% else %}https://www.velotricbike.com/cdn/shop/files/velotric_discover_m_ul_ipx7_certified.webp?v=6942113293339868933{% endif %}{% endcapture %}

<section class="dm-grid" aria-label="Discover M highlights">
  <div class="dm-grid__inner">
    <div class="dm-grid__primary">
      <article class="dm-card dm-card--climb">
        <img src="{{ dm_image_1 | strip }}" alt="{{ section.settings.title_1 | escape }}" width="1080" height="1440">
        <h2>{{ section.settings.title_1 }}</h2>
        <button type="button" class="dm-card__arrow" aria-label="Long Hills Climb details">⌄</button>
      </article>
      <article class="dm-card dm-card--range">
        <img src="{{ dm_image_2 | strip }}" alt="{{ section.settings.title_2 | escape }}" width="1600" height="600">
        <div class="dm-card__range-copy">{{ section.settings.range_prefix }}<br><strong>{{ section.settings.title_2 }}</strong><br>{{ section.settings.range_suffix }}</div>
        <button type="button" class="dm-card__arrow" aria-label="Range details">⌄</button>
      </article>
      <article class="dm-card dm-card--auto">
        <img src="{{ dm_image_3 | strip }}" alt="{{ section.settings.title_3 | escape }}" width="1600" height="600">
        <h2>{{ section.settings.title_3 }}</h2>
        <p>{{ section.settings.subtitle_3 }}</p>
        <button type="button" class="dm-card__arrow" aria-label="Auto Mode details">⌄</button>
      </article>
    </div>

    <div class="dm-grid__secondary">
      <article class="dm-card dm-card--upright">
        <img src="{{ dm_image_4 | strip }}" alt="{{ section.settings.title_4 | escape }}" width="800" height="1100">
        <h2>{{ section.settings.title_4 }}</h2>
        <button type="button" class="dm-card__arrow" aria-label="Upright riding details">⌄</button>
      </article>
      <article class="dm-card dm-card--brake">
        <img src="{{ dm_image_5 | strip }}" alt="{{ section.settings.title_5 | escape }}" width="1000" height="600">
        <h2>{{ section.settings.title_5 }}</h2>
        <button type="button" class="dm-card__arrow" aria-label="Shimano details">⌄</button>
      </article>
      <article class="dm-card dm-card--fork">
        <img src="{{ dm_image_6 | strip }}" alt="{{ section.settings.title_6 | escape }}" width="1000" height="600">
        <h2>{{ section.settings.title_6 }}</h2>
        <button type="button" class="dm-card__arrow" aria-label="Suspension details">⌄</button>
      </article>
      <article class="dm-card dm-card--seat">
        <img src="{{ dm_image_7 | strip }}" alt="{{ section.settings.title_7 | escape }}" width="1000" height="600">
        <h2>{{ section.settings.title_7 | newline_to_br }}</h2>
        <button type="button" class="dm-card__arrow" aria-label="Seatpost details">⌄</button>
      </article>
      <div class="dm-grid__split">
        <article class="dm-card dm-card--find">
          <img src="{{ dm_image_8 | strip }}" alt="{{ section.settings.title_8 | escape }}" width="600" height="600">
          <h2>{{ section.settings.title_8 | newline_to_br }}</h2>
          <button type="button" class="dm-card__arrow" aria-label="Find My details">⌄</button>
        </article>
        <article class="dm-card dm-card--certified">
          <img src="{{ dm_image_9 | strip }}" alt="{{ section.settings.title_9 | escape }}" width="600" height="600">
          <h2>{{ section.settings.title_9 | newline_to_br }}</h2>
          <button type="button" class="dm-card__arrow" aria-label="Certification details">⌄</button>
        </article>
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const section = document.currentScript.previousElementSibling;
    if (!section || section.dataset.motionReady) return;
    section.dataset.motionReady = 'true';
    if (!('IntersectionObserver' in window)) {
      section.classList.add('is-visible');
      return;
    }
    const observer = new IntersectionObserver((entries) => {
      if (!entries[0].isIntersecting) return;
      section.classList.add('is-visible');
      observer.disconnect();
    }, { threshold: 0.08 });
    observer.observe(section);
  })();
</script>

{% schema %}
{
  "name": "Discover M feature grid",
  "settings": [
    {"type":"header","content":"Card 1"},{"type":"image_picker","id":"image_1","label":"Image"},{"type":"text","id":"title_1","label":"Title","default":"Long Hills Climb"},
    {"type":"header","content":"Card 2"},{"type":"image_picker","id":"image_2","label":"Image"},{"type":"text","id":"range_prefix","label":"Top text","default":"Up to"},{"type":"text","id":"title_2","label":"Main text","default":"95 Miles"},{"type":"text","id":"range_suffix","label":"Bottom text","default":"of Range"},
    {"type":"header","content":"Card 3"},{"type":"image_picker","id":"image_3","label":"Image"},{"type":"text","id":"title_3","label":"Title","default":"*Auto Mode"},{"type":"text","id":"subtitle_3","label":"Subtitle","default":"Automatically Adjust Pedal Assist"},
    {"type":"header","content":"Card 4"},{"type":"image_picker","id":"image_4","label":"Image"},{"type":"text","id":"title_4","label":"Title","default":"Upright Riding Position"},
    {"type":"header","content":"Card 5"},{"type":"image_picker","id":"image_5","label":"Image"},{"type":"text","id":"title_5","label":"Title","default":"Shimano CUES 9-Speed"},
    {"type":"header","content":"Card 6"},{"type":"image_picker","id":"image_6","label":"Image"},{"type":"text","id":"title_6","label":"Title","default":"80mm Air Suspension"},
    {"type":"header","content":"Card 7"},{"type":"image_picker","id":"image_7","label":"Image"},{"type":"textarea","id":"title_7","label":"Title","default":"Suspension\nSeatpost"},
    {"type":"header","content":"Card 8"},{"type":"image_picker","id":"image_8","label":"Image"},{"type":"textarea","id":"title_8","label":"Title","default":"Apple Find My &\nGoogle Find My Hub"},
    {"type":"header","content":"Card 9"},{"type":"image_picker","id":"image_9","label":"Image"},{"type":"textarea","id":"title_9","label":"Title","default":"IPX Waterproof\n& UL Certified"}
  ],
  "presets": [{ "name": "Discover M feature grid" }]
}
{% endschema %}
