{{ 'discover-m-ai.css' | asset_url | stylesheet_tag }}

<div class="dm-ai" data-dm-ai>
  <section class="dm-ai__hero">
    <video class="dm-ai__hero-video dm-ai__desktop" autoplay muted loop playsinline preload="metadata" poster="https://www.velotricbike.com/cdn/shop/files/preview_images/6c037c6113de4ddfa78afa2c5e20dcca.thumbnail.0000000000_large.jpg">
      <source src="https://cdn.shopify.com/videos/c/o/v/6c037c6113de4ddfa78afa2c5e20dcca.mp4" type="video/mp4">
    </video>
    <video class="dm-ai__hero-video dm-ai__mobile" autoplay muted loop playsinline preload="metadata" poster="https://www.velotricbike.com/cdn/shop/files/preview_images/574459d21d1e47ecaf521e3f1323f9c1.thumbnail.0000000000_large.jpg">
      <source src="https://cdn.shopify.com/videos/c/o/v/574459d21d1e47ecaf521e3f1323f9c1.mp4" type="video/mp4">
    </video>
    <div class="dm-ai__shade"></div>
    <div class="dm-ai__hero-copy">
      <p>Precise Power. Natural Experience.</p>
      <img src="https://www.velotricbike.com/cdn/shop/files/Discover_M.svg?v=1770087281" alt="Discover M" width="1180" height="192">
      <p class="dm-ai__hero-sub">Mid-Drive Commuter Ebike Powered by VeloCore™ System</p>
      <div class="dm-ai__hero-actions">
        <button type="button" class="dm-ai__button" data-dm-scroll>Explore</button>
        <button type="button" class="dm-ai__button dm-ai__button--ghost" data-dm-video>Watch Video <span>▶</span></button>
      </div>
    </div>
  </section>

  <section class="dm-ai__product" data-dm-product>
    <div class="dm-ai__gallery">
      <span class="dm-ai__new">New</span>
      <img class="dm-ai__bike" data-dm-bike src="https://www.velotricbike.com/cdn/shop/files/DM_Platinum_Sliver_92b9ae6f-b114-443f-a4fe-57dbdc9e04a1.png?v=1777021946&width=1440" alt="Velotric Discover M Platinum Silver" width="1440" height="942">
      <div class="dm-ai__thumbs">
        <button type="button" class="is-active" data-dm-image="https://www.velotricbike.com/cdn/shop/files/DM_Platinum_Sliver_92b9ae6f-b114-443f-a4fe-57dbdc9e04a1.png?v=1777021946&width=1440"><img src="https://www.velotricbike.com/cdn/shop/files/DM_Platinum_Sliver_92b9ae6f-b114-443f-a4fe-57dbdc9e04a1.png?v=1777021946&width=240" alt="Side view" width="240" height="157"></button>
        <button type="button" data-dm-image="https://www.velotricbike.com/cdn/shop/files/DM_Platinum_Sliver_front_47.png?v=1777021946&width=1440"><img src="https://www.velotricbike.com/cdn/shop/files/DM_Platinum_Sliver_front_47.png?v=1777021946&width=240" alt="Front view" width="240" height="157"></button>
        <button type="button" data-dm-image="https://www.velotricbike.com/cdn/shop/files/DM_Platinum_Sliver_rear_47.png?v=1777021946&width=1440"><img src="https://www.velotricbike.com/cdn/shop/files/DM_Platinum_Sliver_rear_47.png?v=1777021946&width=240" alt="Rear view" width="240" height="157"></button>
      </div>
      <div class="dm-ai__trust"><span>1,600+ Dealer Shops</span><span>UL2271 / UL2849</span><span>IPX7 Battery</span></div>
    </div>
    <div class="dm-ai__details">
      <span class="dm-ai__eyebrow">Mid-Drive Commuter Ebike Powered by VeloCore™ System</span>
      <h1>Velotric Discover M Ebike</h1>
      <div class="dm-ai__rating">★★★★★ <span>4.9 · 29 Reviews</span></div>
      <div class="dm-ai__price">$2,499.00</div>
      <div class="dm-ai__choice"><strong>Size: 5'9''–6'7''</strong><div><button class="is-active" type="button">Large</button><button type="button">Regular</button></div></div>
      <div class="dm-ai__choice"><strong>Color: <span data-dm-color-name>Platinum Silver</span></strong><div><button class="dm-ai__swatch dm-ai__swatch--silver is-active" type="button" aria-label="Platinum Silver" data-dm-color="silver"></button><button class="dm-ai__swatch dm-ai__swatch--green" type="button" aria-label="Olivine Green" data-dm-color="green"></button></div></div>
      <div class="dm-ai__specs">
        <div><b>95 Miles</b><span>Max Range</span></div><div><b>28 MPH</b><span>Top Speed</span></div><div><b>Torque/Cadence</b><span>SensorSwap™</span></div><div><b>801.6 Wh</b><span>Battery</span></div><div><b>500W/100Nm</b><span>Motor</span></div><div><b>5 Modes</b><span>Pedal Assist</span></div>
      </div>
      <div class="dm-ai__delivery"><b>Delivery Time:</b> Most orders arrive in 3–5 business days.<br><b>Free Shipping · 14-Day Trial · 2-Year Limited Warranty</b></div>
      <button class="dm-ai__buy" type="button">Buy Now</button>
    </div>
  </section>

  <section class="dm-ai__experts dm-ai__section">
    <h2>Hear from the Experts</h2>
    <div class="dm-ai__quote" data-dm-quotes>
      <blockquote class="is-active">“On the 20% grade, this thing handled it with ease. I love the way these mid-drive motors feel.”</blockquote>
      <blockquote>“This is a very powerful motor. It has 100 Newton meters of torque, but a max of 130.”</blockquote>
      <blockquote>“My big takeaway from the Discover M was just how powerful this motor really is. This thing has no problem with hills.”</blockquote>
    </div>
    <div class="dm-ai__dots"><button class="is-active" type="button" data-dm-quote="0"></button><button type="button" data-dm-quote="1"></button><button type="button" data-dm-quote="2"></button></div>
    <div class="dm-ai__press"><img src="https://www.velotricbike.com/cdn/shop/files/Electric_Bike_Report_38f9b7f3-f183-43b3-9dc0-938623658319.png?v=1784186802&width=300" alt="Electric Bike Report" width="300" height="90"><img src="https://www.velotricbike.com/cdn/shop/files/new-atlas.png?v=1784186795&width=300" alt="New Atlas" width="300" height="90"><img src="https://www.velotricbike.com/cdn/shop/files/EBR_db3c1866-e6d9-4ad8-94b3-1f945ab70128.png?v=1784186816&width=300" alt="Media review" width="300" height="90"></div>
  </section>

  <nav class="dm-ai__nav" aria-label="Page sections"><button type="button">Overview</button><button type="button">Specs</button><button type="button">Reviews</button><button type="button">FAQ</button></nav>

  <section class="dm-ai__overview dm-ai__section">
    <div class="dm-ai__feature-grid">
      <article class="dm-ai__feature dm-ai__feature--large"><img src="https://www.velotricbike.com/cdn/shop/files/mid_drive_motor_ebike_velotric_discover_m.webp?v=10414263997719092939" alt="Mid-drive motor" width="1200" height="850"><h3>Long Hills Climb</h3></article>
      <article class="dm-ai__feature"><img src="https://www.velotricbike.com/cdn/shop/files/long_range_mid_drive_electric_bike.webp?v=7197533249922931453" alt="Long range riding" width="800" height="500"><h3>Up to <strong>95 Miles</strong> of Range</h3></article>
      <article class="dm-ai__feature"><img src="https://www.velotricbike.com/cdn/shop/files/powerful_mid_drive_ebike_for_climbing_hill.webp?v=17164462524060649343" alt="Auto mode" width="800" height="500"><h3>Auto Mode</h3></article>
      <article class="dm-ai__feature"><img src="https://www.velotricbike.com/cdn/shop/files/comfort_mid_drive_ebike_for_seniors.webp?v=324194211173503404" alt="Upright riding position" width="600" height="600"><h3>Upright Riding Position</h3></article>
      <article class="dm-ai__feature"><img src="https://www.velotricbike.com/cdn/shop/files/velotric_discover_m_hydraulic_disc_brake.webp?v=10726079988003261100" alt="Shimano drivetrain" width="600" height="600"><h3>Shimano CUES 9-Speed</h3></article>
      <article class="dm-ai__feature"><img src="https://www.velotricbike.com/cdn/shop/files/velotric_discover_m_front_suspension_fork.webp?v=6463564928672444581" alt="Front suspension" width="600" height="600"><h3>80mm Air Suspension</h3></article>
      <article class="dm-ai__feature"><img src="https://www.velotricbike.com/cdn/shop/files/velotric_discover_m_suspension_seatpost_2.webp?v=1900871556454546865" alt="Suspension seatpost" width="600" height="600"><h3>Suspension Seatpost</h3></article>
      <article class="dm-ai__feature"><img src="https://www.velotricbike.com/cdn/shop/files/velotric_discover_m_smart_locating_feature.webp?v=12993170215933566388" alt="Find My feature" width="600" height="600"><h3>Apple Find My & Google Find Hub</h3></article>
      <article class="dm-ai__feature"><img src="https://www.velotricbike.com/cdn/shop/files/velotric_discover_m_ul_ipx7_certified.webp?v=6942113293339868933" alt="Waterproof certification" width="600" height="600"><h3>IPX Waterproof & UL Certified</h3></article>
    </div>

    <div class="dm-ai__motor">
      <header><h2>Mid-Drive Power, Built for Long Climbs.</h2><p>Built to climb. Tuned to feel natural. With up to 100Nm of torque and a Shimano CUES 9-speed drivetrain, every pedal stroke feels smooth and responsive.</p></header>
      <picture><source media="(max-width: 749px)" srcset="https://www.velotricbike.com/cdn/shop/files/mid_drive_ebike_mountain_trail_riding.webp?v=1783923436&width=1074"><img src="https://www.velotricbike.com/cdn/shop/files/velotric_discover_m_mountain_trail_riding.webp?v=1783923078&width=2400" alt="Discover M climbing a mountain trail" width="2400" height="1440"></picture>
      <div class="dm-ai__motor-stats"><div><b>500W Motor</b><span>960W Peak Power</span></div><div><b>100Nm Torque</b><span>130Nm Max</span></div><div><b>Shimano CUES</b><span>9-Speed</span></div></div>
    </div>

    <div class="dm-ai__modes">
      <header><h2>Ride Farther. Feel More Natural.</h2><p>A smarter mid-drive system adapts assistance to terrain and your riding style.</p></header>
      <div class="dm-ai__mode-copy"><button class="is-active" type="button" data-dm-mode="0">Auto Mode</button><button type="button" data-dm-mode="1">Up to 95 Miles of Range</button><button type="button" data-dm-mode="2">Natural Riding Experience</button></div>
      <div class="dm-ai__mode-media"><img data-dm-mode-image src="https://www.velotricbike.com/cdn/shop/files/velotric_discover_m_different_riding_mode.webp?v=5713558416303668509" alt="Discover M Auto Mode" width="1600" height="900"><p data-dm-mode-text>Automatically adjusts pedal assist on different slopes and terrain.</p></div>
    </div>
  </section>

  <div class="dm-ai__modal" data-dm-modal hidden><button type="button" aria-label="Close video" data-dm-close>×</button><div><iframe data-dm-frame title="Discover M video" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe></div></div>
</div>

<script>
  (() => {
    const root = document.querySelector('[data-dm-ai]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';
    const bike = root.querySelector('[data-dm-bike]');
    root.querySelectorAll('[data-dm-image]').forEach(button => button.addEventListener('click', () => {
      bike.src = button.dataset.dmImage;
      root.querySelectorAll('[data-dm-image]').forEach(item => item.classList.toggle('is-active', item === button));
    }));
    const colors = {
      silver: ['Platinum Silver', 'https://www.velotricbike.com/cdn/shop/files/DM_Platinum_Sliver_92b9ae6f-b114-443f-a4fe-57dbdc9e04a1.png?v=1777021946&width=1440'],
      green: ['Olivine Green', 'https://www.velotricbike.com/cdn/shop/files/DM_Olivine_Green_e3b3daf6-cb0d-4726-a2ae-7309e14f9fe6.png?v=1777021947&width=1440']
    };
    root.querySelectorAll('[data-dm-color]').forEach(button => button.addEventListener('click', () => {
      const choice = colors[button.dataset.dmColor];
      bike.src = choice[1]; root.querySelector('[data-dm-color-name]').textContent = choice[0];
      root.querySelectorAll('[data-dm-color]').forEach(item => item.classList.toggle('is-active', item === button));
    }));
    root.querySelectorAll('[data-dm-quote]').forEach(button => button.addEventListener('click', () => {
      const index = Number(button.dataset.dmQuote);
      root.querySelectorAll('[data-dm-quotes] blockquote').forEach((item, i) => item.classList.toggle('is-active', i === index));
      root.querySelectorAll('[data-dm-quote]').forEach((item, i) => item.classList.toggle('is-active', i === index));
    }));
    const modes = [
      ['https://www.velotricbike.com/cdn/shop/files/velotric_discover_m_different_riding_mode.webp?v=5713558416303668509', 'Automatically adjusts pedal assist on different slopes and terrain.'],
      ['https://www.velotricbike.com/cdn/shop/files/velotric_discover_m_long_range_95_miles.webp?v=4214537198445850146', 'Enjoy the freedom to explore farther without range anxiety.'],
      ['https://www.velotricbike.com/cdn/shop/files/velotric_discover_m_off_road_trail_ride.webp?v=15250042628772205042', 'Balanced handling and smooth, responsive power that feels like riding a real bike.']
    ];
    root.querySelectorAll('[data-dm-mode]').forEach(button => button.addEventListener('click', () => {
      const index = Number(button.dataset.dmMode); root.querySelector('[data-dm-mode-image]').src = modes[index][0]; root.querySelector('[data-dm-mode-text]').textContent = modes[index][1];
      root.querySelectorAll('[data-dm-mode]').forEach((item, i) => item.classList.toggle('is-active', i === index));
    }));
    root.querySelector('[data-dm-scroll]').addEventListener('click', () => root.querySelector('[data-dm-product]').scrollIntoView({behavior:'smooth'}));
    const modal = root.querySelector('[data-dm-modal]'); const frame = root.querySelector('[data-dm-frame]');
    root.querySelector('[data-dm-video]').addEventListener('click', () => { frame.src='https://www.youtube.com/embed/CkdfWeM7kiM?autoplay=1'; modal.hidden=false; document.body.style.overflow='hidden'; });
    root.querySelector('[data-dm-close]').addEventListener('click', () => { modal.hidden=true; frame.src=''; document.body.style.overflow=''; });
  })();
</script>

