              <td>504 Wh</td>
            </tr>
            <tr>
              <td>Max Range</td>
              <td>80 Miles</td>
              <td>55 Miles</td>
            </tr>
            <tr>
              <td>Sensor</td>
              <td>SensorSwap™ Torque/Cadence</td>
              <td>Cadence</td>
            </tr>
            <tr>
              <td>Suspension</td>
              <td>Hydraulic, Lockout</td>
              <td>Hydraulic, Lockout</td>
            </tr>
            <tr>
              <td>Brakes</td>
