  </div>

  <div class="vp-compare" id="vp-section-compare">
    <div class="vp-page-width">
      <h2 class="vp-section-title" data-animate>Compare Models</h2>
      <div class="vp-compare__table-wrapper" data-animate>
        <table class="vp-compare__table">
          <thead>
            <tr>
              <th></th>
              <th>
                <span class="vp-compare__best-seller">Best Seller</span>
                <img src="{{ velotric_img_cherry }}" alt="Discover 3">
                <strong>Discover 3</strong>
                <span>$1,999</span>
