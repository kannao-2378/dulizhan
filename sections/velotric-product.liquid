            </tr>
            <tr>
              <td>Waterproof</td>
              <td>IPX7 / IPX6</td>
              <td>IPX6</td>
            </tr>
            <tr>
              <td>ComfortMax System</td>
              <td><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2D8C3C" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></td>
              <td><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2D8C3C" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></td>
            </tr>
            <tr>
              <td>Smart Features</td>
              <td>NFC + App</td>
              <td>App Only</td>
