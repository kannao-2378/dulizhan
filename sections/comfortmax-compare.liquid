{{ 'comfortmax-compare.css' | asset_url | stylesheet_tag }}
{% capture cm_before_desktop %}{% if section.settings.before_desktop != blank %}{{ section.settings.before_desktop | image_url: width: 2400 }}{% else %}https://www.velotricbike.com/cdn/shop/files/01.webp?v=1776830217{% endif %}{% endcapture %}
{% capture cm_after_desktop %}{% if section.settings.after_desktop != blank %}{{ section.settings.after_desktop | image_url: width: 2400 }}{% else %}https://www.velotricbike.com/cdn/shop/files/02.webp?v=1778639845{% endif %}{% endcapture %}
{% capture cm_before_mobile %}{% if section.settings.before_mobile != blank %}{{ section.settings.before_mobile | image_url: width: 1200 }}{% else %}https://www.velotricbike.com/cdn/shop/files/ride_comfortably_with_velotric_discover_3.webp?v=1776937975{% endif %}{% endcapture %}
{% capture cm_after_mobile %}{% if section.settings.after_mobile != blank %}{{ section.settings.after_mobile | image_url: width: 1200 }}{% else %}https://www.velotricbike.com/cdn/shop/files/cycling_with_pain.webp?v=1778639744{% endif %}{% endcapture %}

<section class="cm-compare" aria-labelledby="cm-title-{{ section.id }}">
  <div class="cm-compare__inner">
    <header class="cm-compare__meta">
      <h2 id="cm-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      <p>{{ section.settings.description | newline_to_br }}</p>
    </header>

    <div class="cm-compare__stage" data-comfort-compare>
      <div class="cm-compare__side cm-compare__before cm-compare__side--desktop">
        <img src="{{ cm_before_desktop | strip }}" alt="Before comparison" width="4096" height="648" loading="lazy">
        <div class="cm-compare__left-label">
          <div class="cm-compare__brand">{{ section.settings.left_brand }}<span>{{ section.settings.left_number }}</span></div>
          <img src="https://cdn.shopify.com/s/files/1/0599/2094/1239/files/Frame_1973773330.svg?v=1776936672" alt="Upright Riding Posture" width="210" height="40" loading="lazy">
        </div>
      </div>
      <div class="cm-compare__side cm-compare__after cm-compare__side--desktop">
        <img src="{{ cm_after_desktop | strip }}" alt="After comparison" width="4096" height="648" loading="lazy">
        <div class="cm-compare__right-label">
          <strong>{{ section.settings.right_title }}</strong>
          <img src="https://cdn.shopify.com/s/files/1/0599/2094/1239/files/Frame_1973773425.svg?v=1776676132" alt="Back Pain, Knee Strain, Saddle Sore, Wrist Pressure" width="404" height="64" loading="lazy">
        </div>
      </div>
      <div class="cm-compare__side cm-compare__before cm-compare__side--mobile">
        <img src="{{ cm_before_mobile | strip }}" alt="Before comparison" width="4096" height="1464" loading="lazy">
      </div>
      <div class="cm-compare__side cm-compare__after cm-compare__side--mobile">
        <img src="{{ cm_after_mobile | strip }}" alt="After comparison" width="4096" height="1464" loading="lazy">
      </div>

      <span class="cm-compare__line" aria-hidden="true"></span>
      <span class="cm-compare__handle" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none"><path d="M7 4v16M12 4v16M17 4v16" stroke="currentColor" stroke-width="1.5"/></svg>
      </span>
      <input class="cm-compare__range" type="range" min="10" max="90" value="64" aria-label="Drag the border between images">
    </div>
  </div>
</section>

<script>
  (() => {
    const root = document.currentScript.previousElementSibling;
    const stage = root && root.querySelector('[data-comfort-compare]');
    const range = stage && stage.querySelector('.cm-compare__range');
    if (!stage || !range) return;
    const render = () => stage.style.setProperty('--cm-position', `${range.value}%`);
    range.addEventListener('input', render);
    render();
  })();
</script>

{% schema %}
{"name":"ComfortMax comparison","settings":[{"type":"text","id":"heading","label":"Heading","default":"ComfortMax™ — Ride in Ultimate Comfort"},{"type":"textarea","id":"description","label":"Description","default":"From your wrists to your arms, back, hips, spine and knees—designed to reduce pressure while you ride. An upright riding position means better posture, less pain, more confidence, and lasting comfort."},{"type":"header","content":"Desktop comparison"},{"type":"image_picker","id":"before_desktop","label":"Left image"},{"type":"image_picker","id":"after_desktop","label":"Right image"},{"type":"header","content":"Mobile comparison"},{"type":"image_picker","id":"before_mobile","label":"Left image"},{"type":"image_picker","id":"after_mobile","label":"Right image"},{"type":"header","content":"Labels"},{"type":"text","id":"left_brand","label":"Left brand text","default":"Discover."},{"type":"text","id":"left_number","label":"Left brand number","default":"3"},{"type":"text","id":"right_title","label":"Right title","default":"Other"}],"presets":[{"name":"ComfortMax comparison"}]}
{% endschema %}
